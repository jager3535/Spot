<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Spot.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- macOS Spotlight dili: koyu, yarı saydam düz gövde, tek ince kenar, seçim düz
                 mavi. Bulanıklık arkadaki tam ekran perdeden gelir. -->
            <SolidColorBrush x:Key="PanelDolgu" Color="#D8242427" />
            <SolidColorBrush x:Key="PanelKenar" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="Ayirici" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="SecimDolgu" Color="#0A63D8" />

            <Style x:Key="BaslikStili" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#80FFFFFF" />
                <Setter Property="Margin" Value="10,6,0,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
