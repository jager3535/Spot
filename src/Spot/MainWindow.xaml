<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Spot.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Spot">

    <!-- Kok tüm ekranı kaplayan perde (saydam ama tıklanabilir); Panel ortadaki cam katman. -->
    <Grid x:Name="Kok" Background="Transparent">
    <!-- Panel: macOS Spotlight benzeri. Katmanlar alttan üste: yumuşak gölge, gövde (ince
         kenarlı), içerik. Arama satırı gövdeye gömülü; sonuçlar ince bir çizgiyle ayrılır. -->
    <Grid x:Name="Panel" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Border Margin="-8,6,-8,-18" CornerRadius="28" Background="#12000000" IsHitTestVisible="False" />
        <Border Margin="-3,2,-3,-6" CornerRadius="23" Background="#1E000000" IsHitTestVisible="False" />
        <Border CornerRadius="20" Background="{StaticResource PanelDolgu}"
                BorderThickness="1" BorderBrush="{StaticResource PanelKenar}" />
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Arama satırı: ayrı kutu yok, gövdenin kendisi -->
        <Grid Height="60" Padding="20,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <FontIcon Glyph="&#xE721;" FontSize="20" Foreground="#99FFFFFF" Margin="0,0,14,0" />

            <!-- Soluk tamamlama: sorgu kadarı saydam, kalanı soluk. TextBox ile aynı font ve hizada. -->
            <!-- Alt pay 1.6: TextBox metni TextBlock'tan ~1 px yukarıda çiziyor (125%'te ölçüldü). -->
            <TextBlock x:Name="Hayalet" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,1.6"
                       FontSize="24" FontWeight="Light" IsHitTestVisible="False" TextWrapping="NoWrap">
                <Run x:Name="HayaletSorgu" Foreground="Transparent" /><Run x:Name="HayaletTamamlama" Foreground="#99FFFFFF" /><Run x:Name="HayaletEk" Foreground="#66FFFFFF" />
            </TextBlock>

            <TextBox x:Name="Kutu" Grid.Column="1" VerticalAlignment="Center"
                     FontSize="24" FontWeight="Light" Padding="0" MinHeight="0" BorderThickness="0"
                     Background="Transparent" PlaceholderText="Uygulama ara"
                     IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                     TextChanged="Kutu_TextChanged" PreviewKeyDown="Kutu_PreviewKeyDown">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#80FFFFFF" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </TextBox.Resources>
            </TextBox>
        </Grid>

        <!-- Sonuçlar -->
        <StackPanel x:Name="Sonuclar" Grid.Row="1" Visibility="Collapsed" Padding="10,6,10,10" Spacing="2"
                    BorderThickness="0,1,0,0" BorderBrush="{StaticResource Ayirici}">
            <TextBlock Text="En İyi Eşleşen" Style="{StaticResource BaslikStili}" />
            <StackPanel x:Name="EnIyiAlan" />
            <TextBlock x:Name="DigerBaslik" Text="Uygulamalar" Style="{StaticResource BaslikStili}" Margin="10,10,0,4" />
            <StackPanel x:Name="DigerAlan" Spacing="2" />
            <TextBlock x:Name="KlasorBaslik" Text="Klasörler" Style="{StaticResource BaslikStili}" Margin="10,10,0,4" />
            <StackPanel x:Name="KlasorAlan" Spacing="2" />
        </StackPanel>
    </Grid>
    </Grid>
    </Grid>
</Window>
